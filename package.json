{
  "name": "survey-control-room",
  "version": "2.15.6",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build_static_snapshots.mjs",
    "preview": "vite preview",
    "test:py": "python -m unittest discover -s tests",
    "start": "python database.py",
    "deploy": "python deploy_r2.py",
    "deploy:r2": "python deploy_r2.py",
    "export:photos": "node scripts/export_photos.mjs",
    "export:photos:py": "python export_photos.py",
    "export:pdf": "python export_pdf.py",
    "export:archive": "python export_pdf.py --archive",
    "etl:d1": "node scripts/d1_etl_export.mjs",
    "d1:migrate:local": "node ./scripts/run-wrangler.cjs d1 migrations apply pre-pm2-prod --local",
    "d1:migrate:remote": "node ./scripts/run-wrangler.cjs d1 migrations apply pre-pm2-prod --remote",
    "d1:seed:local": "node ./scripts/run-wrangler.cjs d1 execute pre-pm2-prod --local --file=./migrations/0002_seed_data.sql",
    "d1:seed:remote": "node ./scripts/run-wrangler.cjs d1 execute pre-pm2-prod --remote --file=./migrations/0002_seed_data.sql",
    "wrangler": "node ./scripts/run-wrangler.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.5.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.3"
  }
}
